require 'dotenv'
Dotenv.load(File.join(File.dirname(__FILE__), '.env'))

default_platform(:mac)

# xcodebuild args for automatic signing on a headless runner: `-allowProvisioningUpdates` lets
# Xcode fetch the provisioning profiles from Apple, authenticated with the App Store Connect API key
# instead of a logged-in Xcode account. The certificates themselves are already in the runner's
# keychain (same approach as ontrainer on the shared Mac mini). Locally, without ASC_KEY_PATH, Xcode
# uses the signed-in account.
def asc_xcargs
  args = "-allowProvisioningUpdates"
  key_path = ENV["ASC_KEY_PATH"].to_s
  if !key_path.empty? && File.exist?(key_path)
    args += " -authenticationKeyPath #{File.expand_path(key_path).shellescape}"
    args += " -authenticationKeyID #{ENV['ASC_KEY_ID']}"
    args += " -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
  end
  args
end

platform :mac do
  desc "Read version name from pubspec.yaml"
  private_lane :get_version_name do
    pubspec = File.read("../../pubspec.yaml")
    version_full = pubspec.match(/version:\s*(\S+)/)[1]
    version_full.split("+")[0]
  end

  desc "Get App Store Connect API key (supports local file or base64)"
  private_lane :get_asc_api_key do
    if ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
      key_path = File.expand_path(ENV["ASC_KEY_PATH"])
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: key_path
      )
    elsif ENV["ASC_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true
      )
    else
      UI.user_error!("Missing App Store Connect API key. Set either ASC_KEY_PATH (local) or ASC_KEY_CONTENT (CI)")
    end
  end

  desc "Fix framework symlinks for App Store (ITMS-90291)"
  private_lane :fix_framework_symlinks do |options|
    archive_path = options[:archive_path] || lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    fw_dir = File.join(archive_path, "Products", "Applications", "HealthWallet.me.app", "Contents", "Frameworks")

    unless Dir.exist?(fw_dir)
      UI.important("Frameworks dir not found: #{fw_dir}")
      next
    end

    UI.message("Fixing framework symlinks in: #{fw_dir}")
    Dir.glob("#{fw_dir}/*.framework").each do |fw|
      fw_name = File.basename(fw, ".framework")
      resources_link = File.join(fw, "Resources")
      has_versions = File.exist?(File.join(fw, "Versions"))

      if File.symlink?(resources_link)
        target = File.readlink(resources_link)
        if target != "Versions/Current/Resources"
          UI.message("  #{fw_name}: fixing Resources symlink #{target} → Versions/Current/Resources")
          FileUtils.rm(resources_link)
          File.symlink("Versions/Current/Resources", resources_link)
        else
          UI.message("  #{fw_name}: OK")
        end
      elsif has_versions
        UI.message("  #{fw_name}: adding missing Resources symlink")
        versioned_res = File.join(fw, "Versions", "Current", "Resources")
        FileUtils.mkdir_p(versioned_res) unless File.exist?(versioned_res)
        FileUtils.rm_rf(resources_link) if File.exist?(resources_link)
        File.symlink("Versions/Current/Resources", resources_link)
      end
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = get_asc_api_key

    version_name = get_version_name

    build_number = latest_testflight_build_number(
      api_key: api_key,
      version: version_name,
      platform: "osx",
      initial_build_number: 0
    ) + 1

    UI.message("Building macOS version #{version_name} (#{build_number})")

    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        sh("fvm", "flutter", "build", "macos", "--release",
           "--target", "lib/main_desktop.dart",
           "--build-number=#{build_number}",
           "--build-name=#{version_name}")
      end
    end

    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      skip_package_pkg: true,
      xcargs: asc_xcargs
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    fix_framework_symlinks(archive_path: archive_path)

    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      skip_build_archive: true,
      archive_path: archive_path,
      export_xcargs: asc_xcargs,
      export_options: {
        signingStyle: "automatic",
        teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Find the Developer ID Application identity for the team in the keychain (SHA-1 and name)"
  private_lane :developer_id_identity do |options|
    team_id = options[:team_id]
    identities = sh("security", "find-identity", "-v", "-p", "codesigning", log: false)
    match = identities.match(/^\s*\d+\)\s+([0-9A-F]{40})\s+"(Developer ID Application: [^"]*\(#{Regexp.escape(team_id)}\))"/)

    unless match
      UI.user_error!(
        "No valid \"Developer ID Application\" certificate for team #{team_id} in the keychain, " \
        "so the direct-download build cannot be signed.\n" \
        "1. The team's Account Holder creates it: Xcode > Settings > Accounts > (team #{team_id}) > " \
        "Manage Certificates > + > Developer ID Application, or at " \
        "https://developer.apple.com/account/resources/certificates/add (Developer ID Application, G2 Sub-CA) " \
        "with a CSR from Keychain Access.\n" \
        "2. Export it with its private key from Keychain Access as a .p12.\n" \
        "3. On the Mac mini, import it into the runner's login keychain: " \
        "security import DeveloperID.p12 -k ~/Library/Keychains/login.keychain-db -P '<p12 password>' " \
        "-T /usr/bin/codesign -T /usr/bin/security -T /usr/bin/productbuild\n" \
        "4. Check that it is listed: security find-identity -v -p codesigning"
      )
    end

    UI.message("Signing with #{match[2]}")
    { sha1: match[1], name: match[2] }
  end

  desc "Build a notarized DMG for direct download (outside the App Store)"
  lane :direct do
    team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
    identity = developer_id_identity(team_id: team_id)
    api_key = get_asc_api_key

    version_name = get_version_name
    build_number = ENV["CI_PIPELINE_IID"].to_s.empty? ? "1" : ENV["CI_PIPELINE_IID"].to_s

    repo_root = File.expand_path("../..")
    work_dir = File.join(repo_root, "build", "macos", "direct")
    packages_dir = File.join(repo_root, "build", "macos", "packages")
    dmg_path = File.join(packages_dir, "HealthWallet-macOS-v#{version_name}.dmg")

    UI.message("Building macOS direct download #{version_name} (#{build_number})")

    FileUtils.rm_rf(work_dir)
    FileUtils.rm_rf(packages_dir)
    FileUtils.mkdir_p(work_dir)
    FileUtils.mkdir_p(packages_dir)

    Dir.chdir(repo_root) do
      Bundler.with_unbundled_env do
        sh("fvm", "flutter", "build", "macos", "--release",
           "--target", "lib/main_desktop.dart",
           "--build-number=#{build_number}",
           "--build-name=#{version_name}")
      end
    end

    # Notarization requires the hardened runtime; the project leaves it off (the App Store build
    # does not need it), so it is turned on for this archive only.
    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      skip_package_pkg: true,
      output_directory: work_dir,
      xcargs: "#{asc_xcargs} ENABLE_HARDENED_RUNTIME=YES"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    fix_framework_symlinks(archive_path: archive_path)

    # Re-signs the archived app with the Developer ID Application certificate.
    app_path = build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "developer-id",
      skip_build_archive: true,
      archive_path: archive_path,
      output_directory: work_dir,
      output_name: "HealthWallet.me",
      export_xcargs: asc_xcargs,
      export_options: {
        signingStyle: "automatic",
        teamID: team_id
      }
    )
    UI.user_error!("Exported app not found at #{app_path}") unless app_path && File.directory?(app_path)

    sh("codesign", "--verify", "--deep", "--strict", "--verbose=2", app_path)
    signature = sh("codesign", "--display", "--verbose=2", app_path, log: false)
    UI.user_error!("#{app_path} is not signed with a Developer ID Application certificate") unless signature.include?("Authority=Developer ID Application")
    UI.user_error!("#{app_path} is not signed with the hardened runtime") unless signature.match?(/flags=0x[0-9a-f]+\(.*runtime.*\)/)

    # DMG with the app and a link to /Applications to drag it onto.
    staging_dir = File.join(work_dir, "dmg")
    FileUtils.mkdir_p(staging_dir)
    sh("ditto", app_path, File.join(staging_dir, File.basename(app_path)))
    File.symlink("/Applications", File.join(staging_dir, "Applications"))
    sh("hdiutil", "create",
       "-volname", "HealthWallet.me",
       "-srcfolder", staging_dir,
       "-fs", "HFS+",
       "-format", "UDZO",
       "-ov", dmg_path)

    sh("codesign", "--force", "--sign", identity[:sha1], "--timestamp", dmg_path)
    sh("codesign", "--verify", "--strict", "--verbose=2", dmg_path)

    # Submits the DMG (Apple checks the app inside it too), waits for the result and staples the ticket.
    notarize(
      package: dmg_path,
      api_key: api_key,
      print_log: true
    )
    sh("spctl", "--assess", "--type", "open", "--context", "context:primary-signature", "--verbose=2", dmg_path)

    UI.success("Notarized DMG: #{dmg_path}")
  end
end
