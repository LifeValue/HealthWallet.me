require 'dotenv'
Dotenv.load(File.join(File.dirname(__FILE__), '.env'))

default_platform(:mac)

platform :mac do
  desc "Read version name from pubspec.yaml"
  private_lane :get_version_name do
    pubspec = File.read("../../pubspec.yaml")
    version_full = pubspec.match(/version:\s*(\S+)/)[1]
    version_full.split("+")[0]
  end

  desc "Get App Store Connect API key (supports local file or base64)"
  private_lane :get_asc_api_key do
    if ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
      key_path = File.expand_path(ENV["ASC_KEY_PATH"])
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: key_path
      )
    elsif ENV["ASC_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true
      )
    else
      UI.user_error!("Missing App Store Connect API key. Set either ASC_KEY_PATH (local) or ASC_KEY_CONTENT (CI)")
    end
  end

  desc "Sync certificates and provisioning profiles via Match"
  lane :sync_certificates do
    api_key = get_asc_api_key

    match(
      type: "appstore",
      platform: "macos",
      app_identifier: ["com.techstackapps.healthwallet"],
      api_key: api_key,
      readonly: is_ci,
      generate_apple_certs: false,
      additional_cert_types: ["mac_installer_distribution"]
    )
  end

  desc "Fix framework symlinks for App Store (ITMS-90291)"
  private_lane :fix_framework_symlinks do |options|
    archive_path = options[:archive_path] || lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    fw_dir = File.join(archive_path, "Products", "Applications", "health_wallet.app", "Contents", "Frameworks")

    unless Dir.exist?(fw_dir)
      UI.important("Frameworks dir not found: #{fw_dir}")
      next
    end

    UI.message("Fixing framework symlinks in: #{fw_dir}")
    Dir.glob("#{fw_dir}/*.framework").each do |fw|
      fw_name = File.basename(fw, ".framework")
      resources_link = File.join(fw, "Resources")
      has_versions = File.exist?(File.join(fw, "Versions"))

      if File.symlink?(resources_link)
        target = File.readlink(resources_link)
        if target != "Versions/Current/Resources"
          UI.message("  #{fw_name}: fixing Resources symlink #{target} → Versions/Current/Resources")
          FileUtils.rm(resources_link)
          File.symlink("Versions/Current/Resources", resources_link)
        else
          UI.message("  #{fw_name}: OK")
        end
      elsif has_versions
        UI.message("  #{fw_name}: adding missing Resources symlink")
        versioned_res = File.join(fw, "Versions", "Current", "Resources")
        FileUtils.mkdir_p(versioned_res) unless File.exist?(versioned_res)
        FileUtils.rm_rf(resources_link) if File.exist?(resources_link)
        File.symlink("Versions/Current/Resources", resources_link)
      end
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    sync_certificates

    api_key = get_asc_api_key

    version_name = get_version_name

    build_number = latest_testflight_build_number(
      api_key: api_key,
      version: version_name,
      platform: "osx",
      initial_build_number: 0
    ) + 1

    UI.message("Building macOS version #{version_name} (#{build_number})")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_com.techstackapps.healthwallet_appstore_macos_profile-name"]
    )

    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        sh("fvm", "flutter", "build", "macos", "--release",
           "--target", "lib/main_desktop.dart",
           "--build-number=#{build_number}",
           "--build-name=#{version_name}")
      end
    end

    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      skip_package_pkg: true
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    fix_framework_symlinks(archive_path: archive_path)

    build_mac_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      skip_build_archive: true,
      archive_path: archive_path,
      export_options: {
        provisioningProfiles: {
          "com.techstackapps.healthwallet" => ENV["sigh_com.techstackapps.healthwallet_appstore_macos_profile-name"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Release — uploads to TestFlight (production promotion is manual in ASC)"
  lane :release do
    beta
  end
end
