require 'dotenv'
Dotenv.load(File.join(File.dirname(__FILE__), '.env'))

default_platform(:ios)

# xcodebuild args for automatic signing on a headless runner: `-allowProvisioningUpdates` lets
# Xcode fetch the provisioning profiles from Apple, authenticated with the App Store Connect API key
# instead of a logged-in Xcode account. The certificates themselves are already in the runner's
# keychain (same approach as ontrainer on the shared Mac mini). Locally, without ASC_KEY_PATH, Xcode
# uses the signed-in account.
def asc_xcargs
  args = "-allowProvisioningUpdates"
  key_path = ENV["ASC_KEY_PATH"].to_s
  if !key_path.empty? && File.exist?(key_path)
    args += " -authenticationKeyPath #{File.expand_path(key_path).shellescape}"
    args += " -authenticationKeyID #{ENV['ASC_KEY_ID']}"
    args += " -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
  end
  args
end

platform :ios do
  desc "Read version name from pubspec.yaml"
  private_lane :get_version_name do
    pubspec = File.read("../../pubspec.yaml")
    version_full = pubspec.match(/version:\s*(\S+)/)[1]
    version_full.split("+")[0]
  end

  desc "Get App Store Connect API key (supports local file or base64)"
  private_lane :get_asc_api_key do
    if ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
      key_path = File.expand_path(ENV["ASC_KEY_PATH"])
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: key_path
      )
    elsif ENV["ASC_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true
      )
    else
      UI.user_error!("Missing App Store Connect API key. Set either ASC_KEY_PATH (local) or ASC_KEY_CONTENT (CI)")
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = get_asc_api_key

    version_name = get_version_name

    build_number = latest_testflight_build_number(
      api_key: api_key,
      version: version_name,
      initial_build_number: 0
    ) + 1

    UI.message("Building version #{version_name} (#{build_number})")

    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        begin
          sh("shorebird", "release", "--platforms", "ios", "--no-codesign",
             "--flutter-version=3.47.7",
             "--build-number=#{build_number}",
             "--build-name=#{version_name}")
        rescue => e
          UI.important("Shorebird release failed (#{e.message}), falling back to flutter build")
          sh("fvm", "flutter", "build", "ios", "--release", "--no-codesign",
             "--build-number=#{build_number}",
             "--build-name=#{version_name}")
        end
      end
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      skip_package_ipa: true,
      xcargs: asc_xcargs
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    fw_dir = File.join(archive_path, "Products", "Applications", "Runner.app", "Frameworks")
    if Dir.exist?(fw_dir)
      sdk_ver = `xcrun --sdk iphoneos --show-sdk-version`.strip
      UI.message("Patching embedded frameworks (target iOS 16.0, SDK #{sdk_ver})")
      Dir.glob("#{fw_dir}/*.framework").each do |fw|
        plist = File.join(fw, "Info.plist")
        sh("plutil", "-replace", "MinimumOSVersion", "-string", "16.0", plist) if File.exist?(plist)

        binary = File.join(fw, File.basename(fw, ".framework"))
        if File.exist?(binary)
          sh("xcrun", "vtool", "-set-build-version", "ios", "16.0", sdk_ver,
             "-replace", "-output", "#{binary}.patched", binary)
          FileUtils.mv("#{binary}.patched", binary)
        end
      end
      UI.message("Patched MinimumOSVersion to 16.0 in all embedded frameworks")
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      skip_build_archive: true,
      archive_path: archive_path,
      export_xcargs: asc_xcargs,
      export_options: {
        signingStyle: "automatic",
        teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Release — uploads to TestFlight (production promotion is manual in ASC)"
  lane :release do
    beta
  end
end
