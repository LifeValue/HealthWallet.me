# Claude Code
.claude/
.mcp.json

# BMad install (each developer runs the BMad installer; planning output in _bmad-output/ stays tracked)
_bmad/

# Secrets & Signing Keys - NEVER commit these
**/private_keys/
**/service-account*.json
*.p8
*.p12
*.cer
*.pem
assets/certs/*
!assets/certs/.gitkeep
!assets/certs/android/
assets/certs/android/*
!assets/certs/android/.gitkeep
*.jks
*.keystore
**/key.properties
**/fastlane/.env
**/fastlane/.env.*
!**/fastlane/.env.example

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Bundler's local settings and the plugins it installs from the Gemfiles
**/.bundle/

# exclude the API key from version control
env.g.dart
*.env

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
/coverage/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# snapcraft pack (snap/snapcraft.yaml) on the host or in destructive mode
/parts/
/stage/
/prime/
/*.snap

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release



**/*.freezed.dart
**/*.g.dart
**/*.config.dart
**/*.gr.dart

pubspec_overrides.yaml

# FVM Version Cache
.fvm/

.vscode/settings.json

# Fastlane
ios/fastlane/Appfile
ios/fastlane/Matchfile
