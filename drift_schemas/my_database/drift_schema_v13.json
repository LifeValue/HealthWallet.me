  "fixed_sql": [
    {
      "name": "fhir_resource",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fhir_resource\" (\"id\" TEXT NOT NULL, \"source_id\" TEXT NULL, \"resource_type\" TEXT NULL, \"resource_id\" TEXT NULL, \"title\" TEXT NULL, \"date\" INTEGER NULL, \"resource_raw\" TEXT NOT NULL, \"encounter_id\" TEXT NULL, \"subject_id\" TEXT NULL, \"updated_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NULL, \"specialty_override\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sources\" (\"id\" TEXT NOT NULL, \"platform_name\" TEXT NULL, \"logo\" TEXT NULL, \"label_source\" TEXT NULL, \"platform_type\" TEXT NOT NULL DEFAULT 'wallet', \"created_at\" INTEGER NULL, \"updated_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "record_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"record_notes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uuid\" TEXT NULL, \"resource_id\" TEXT NOT NULL, \"source_id\" TEXT NULL REFERENCES sources (id), \"content\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"updated_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "processing_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"processing_sessions\" (\"id\" TEXT NOT NULL, \"file_paths\" TEXT NULL, \"resources\" TEXT NULL, \"status\" TEXT NULL, \"origin\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"patient\" TEXT NULL, \"encounter\" TEXT NULL, \"is_document_attached\" INTEGER NULL CHECK (\"is_document_attached\" IN (0, 1)), \"updated_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_outbox\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"synced_table\" TEXT NOT NULL, \"row_key\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "resourceType",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX resourceType ON fhir_resource (resource_type)"
        }
      ]
    },
    {
      "name": "resourceId",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX resourceId ON fhir_resource (resource_id)"
        }
      ]
    },
    {
      "name": "record_notes_uuid",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX record_notes_uuid ON record_notes (uuid)"
        }
      ]
    }
